# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# MQTT broker connection (include scheme: tls:// for port 8883, tcp:// for 1883)
MQTT_BROKER_URL=tls://your-broker-host:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=telegram-relay-controller

# Must match the topic the ESP8266 firmware subscribes to
MQTT_TOPIC=

# Comma-separated Telegram user IDs allowed to control the relay
ALLOWED_TELEGRAM_USER_IDS=
